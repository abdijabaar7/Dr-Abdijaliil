# Supabase Configuration
# Get these from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# Supabase Service Role Key (Used strictly server-side for admin tasks; NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clinic WhatsApp Contact (international format without + or spaces, e.g. 252610000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=252615000000

